---
import { Flame, House, Mountain, Snowflake } from "@lucide/astro";
import AreaPage from "@/components/AreaPage.astro";
import { bandRange, ductedBands, ductedExtras, extraPrice, installTimes, type Faq } from "@/data/ducted";
import heroImg from "@/assets/images/banner-van-customers.webp";

// Owner: "lots of experience in the Kalamunda area", "specialise in difficult jobs".
// TODO(owner): confirm the suburb list; add a Hills project when there's one.
const suburbs = [
  "Kalamunda", "Lesmurdie", "Gooseberry Hill", "Walliston", "Bickley", "Carmel", "Paulls Valley",
  "Pickering Brook", "Piesse Brook", "Hacketts Gully", "Canning Mills", "Forrestfield", "High Wycombe",
  "Maida Vale", "Wattle Grove",
];
const [small, medium, large] = ductedBands;

const faqs: Faq[] = [
  { q: "Do you install air conditioning in Kalamunda and the Hills?", a: `Yes — we've done a lot of work in Kalamunda and the surrounding Hills, including ${suburbs.slice(1, 6).join(", ")} and nearby suburbs. Send us your suburb with a quote request and we'll confirm.` },
  { q: "What's the best air conditioning for a Hills home?", a: "For most Hills homes we recommend ducted reverse cycle: it heats every room through colder Hills winters, cools with the windows shut on smoky summer days, and zoning keeps running costs down. Split systems suit smaller homes or single rooms." },
  { q: "Can you replace my evaporative cooler in the Hills?", a: `Yes. Removing the evaporative cooler is ${extraPrice(ductedExtras.evapRemoval)}, including patching the tiles with your spare tiles (or capping the dropper). Metal roofs need the sheets patched: ${extraPrice(ductedExtras.roofSheets)}. The whole changeover is ${installTimes.withEvapRemoval}.` },
  { q: "My house is older with a tight roof space — can you still install ducted?", a: "Often, yes. Tight roof spaces, raked ceilings and add-on extensions are common in the Hills, and difficult installs are our specialty. We'll inspect the roof space and tell you honestly what's possible before you commit." },
  { q: "Is reverse cycle heating good enough for Hills winters?", a: "Yes. Modern inverter reverse cycle systems heat efficiently in Perth's winter conditions, including the Hills, and ducted spreads that heat through every zone you have switched on." },
];
---

<AreaPage
  path="/air-conditioning-kalamunda"
  area="Kalamunda"
  breadcrumb="Kalamunda & Perth Hills"
  seoTitle="Air Conditioning Kalamunda & Perth Hills | Pro Vent"
  seoDescription="Ducted, split and evaporative-to-ducted air conditioning in Kalamunda, Lesmurdie, Forrestfield and the Perth Hills. Family-owned, ARCtick licensed."
  eyebrow="Kalamunda & the Perth Hills"
  title="Air Conditioning Kalamunda & the Perth Hills"
  lead="Ducted reverse cycle specialists with years of experience in Kalamunda and the Hills — heating for cold Hills winters, cooling with the windows shut on smoky summer days, and the know-how for older homes and tricky roof spaces."
  heroImage={heroImg}
  heroAlt="Pro Vent technician talking with homeowners beside the work van"
  factorsTitle="Air conditioning for Hills homes"
  factorsLead="Up in the Hills, homes deal with things the coastal suburbs don't. Here's what we plan for on every Kalamunda and Hills job."
  factors={[
    { icon: Snowflake, title: "Colder winters", body: "Hills nights get noticeably colder than down on the coastal plain, so heating matters as much as cooling. Reverse cycle does both from one system — ducted heats every room, not just the lounge." },
    { icon: Flame, title: "Bushfire smoke season", body: "Evaporative coolers pull outside air through the house, smoke and all. Reverse cycle cools with the windows and doors shut, which makes a real difference on smoky summer days." },
    { icon: House, title: "Older and character homes", body: "Raked ceilings, tight or low-pitched roof spaces, additions built at different times — older Hills homes often need ductwork planned around them. Difficult jobs are what we do." },
    { icon: Mountain, title: "Sloping and split-level blocks", body: "Split-level homes and sloping blocks change where the outdoor unit can go and how the ducts and pipes run. We plan it on site rather than guessing." },
  ]}
  services={[
    { title: "Ducted air conditioning", body: "Whole-home reverse cycle heating and cooling, zoned so you only run the rooms you're using.", href: "/ducted-air-conditioning" },
    { title: "Evaporative to ducted", body: `Swap the old roof cooler for reverse cycle — removal ${extraPrice(ductedExtras.evapRemoval)} including tile patching, usually done in a day.`, href: "/evaporative-to-ducted-reverse-cycle" },
    { title: "Split systems", body: "Targeted heating and cooling for bedrooms, studios and extensions.", href: "/split-system-air-conditioning" },
    { title: "Service & repairs", body: "Fault-finding and repairs on all brands, including older systems.", href: "/service-repairs" },
  ]}
  evapLead="Plenty of Hills homes still have an evaporative unit on the roof. Swapping it for ducted reverse cycle gives you winter heating and smoke-free summer cooling."
  suburbGroups={[{ title: "Shire of Kalamunda", suburbs }]}
  tricky={{ title: "Got a tricky Hills home?", body: "Tight roof space, raked ceilings or a split-level block — send us photos or plans with your quote request and we'll tell you what's possible." }}
  pricingLead="Typical installed prices for single-storey homes, inc GST. Split-level Hills homes and double-storeys need an inspection first, as the layout decides what's possible."
  faqs={faqs}
/>
