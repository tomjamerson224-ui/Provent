---
import SystemPage from "@/components/SystemPage.astro";
import heroImg from "@/assets/images/evaporative-roof-unit.webp";
import whyImg from "@/assets/images/tech-with-client-2.webp";
---

<SystemPage
  path="/evaporative-air-conditioning"
  category="evaporative"
  seoTitle="Evaporative Air Conditioning Perth | Pro Vent"
  seoDescription="Evaporative air conditioning supplied, installed and replaced across Perth. Fresh, budget-friendly whole-home cooling for hot, dry summers."
  eyebrow="Evaporative air conditioning"
  title="Evaporative Air Conditioning Perth"
  lead="Whole-home cooling that uses water and a single fan instead of an energy-hungry compressor — made for Perth's hot, dry summers."
  heroImage={heroImg}
  heroAlt="Evaporative cooler mounted on a terracotta tiled roof in Perth"
  heroFocus="center 30%"
  whyTitle="Why choose evaporative air conditioning?"
  why={[
    { title: "Lower bills, cooler summers", body: "Using water and a single fan instead of a big compressor, evaporative systems can save you up to 80% on running costs compared with refrigerated air conditioning, while keeping your home cool through Perth's hot, dry summers." },
    { title: "Naturally fresh airflow", body: "Keep a few doors or windows slightly open and the system pulls in a steady flow of cool, fresh air while pushing warm, stale air out." },
    { title: "Whole-home coverage", body: "One roof unit sends cool air through slim vents to every room — bedrooms, living areas, even large workshops. Lightweight ducts fit most roofs easily." },
  ]}
  whyImage={whyImg}
  whyImageAlt="Pro Vent technician meeting a homeowner at the front of their house"
  benefitsTitle="Benefits of evaporative air conditioners"
  benefits={[
    { title: "Even temperature everywhere", body: "A single central system keeps every corner of your home comfortable." },
    { title: "Room-by-room control", body: "Zoned outlets let you cool only the rooms you're using, saving energy and money." },
    { title: "Seamless ceiling finish", body: "Hidden ducts and slim vents blend into any décor, leaving walls and floors clutter-free." },
    { title: "Peaceful performance", body: "The working parts live on the roof — inside you'll hear little more than a soft, steady breeze." },
  ]}
  projectsTitle="Evaporative air conditioner installs"
>
  <section slot="after-benefits" class="py-12">
    <div class="container-page">
      <a href="/blog/evaporative-vs-refrigerated-cooling-perth" class="flex flex-col gap-2 rounded-2xl border bg-card p-6 transition hover:border-brand hover:shadow-md sm:flex-row sm:items-center sm:justify-between">
        <span><span class="block font-semibold">Evaporative or refrigerated — which suits your home?</span><span class="text-muted-foreground">Our Perth comparison covers running costs, humid days, heating and what switching costs.</span></span>
        <span class="shrink-0 font-semibold text-brand-dark">Read the guide →</span>
      </a>
    </div>
  </section>
</SystemPage>
