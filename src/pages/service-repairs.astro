---
import { Image } from "astro:assets";
import { Phone } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import FeatureSplit from "@/components/sections/FeatureSplit.astro";
import BenefitGrid from "@/components/sections/BenefitGrid.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import BrandStrip from "@/components/sections/BrandStrip.astro";
import LinkButton from "@/components/LinkButton.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import { business, whyProVent } from "@/data/site";
import { faqSchema, type Faq } from "@/data/ducted";

import heroImg from "@/assets/images/banner-tech-gauges.webp";
import portraitImg from "@/assets/images/tech-service-portrait.avif";
import imgBreakdown from "@/assets/images/tech-crouched-unit.avif";
import imgDiagnostics from "@/assets/images/tech-diagnostics.avif";
import imgAirflow from "@/assets/images/homeowner-controller.avif";
import imgLeak from "@/assets/images/split-water-leak.webp";
import imgNoise from "@/assets/images/tech-inspecting-unit.webp";
import imgGas from "@/assets/images/tech-gauges.webp";

const serviceFaqs: Faq[] = [
  { q: "Do you repair all air conditioner brands?", a: "Yes. We service and repair all brands and models — split systems, ducted systems and multi-head units — including older systems other companies won't touch." },
  { q: "Will I know the cost before you start?", a: "Yes. We find the fault first and give you a clear, up-front quote before any repair work starts, so there are no surprises on the bill." },
  { q: "Do you service ducted air conditioning?", a: "Yes. Ducted reverse cycle is our specialty — we service, fault-find and repair ducted systems whether or not we installed them." },
  { q: "Should I repair or replace my air conditioner?", a: "If the system is relatively young and the fault is a part-level repair, fixing it is usually the better value. If it's old, inefficient or needs a major component like a compressor, replacing it can make more sense. We'll give you honest advice either way." },
  { q: "What areas do you cover?", a: "The Perth CBD and surrounding suburbs, with plenty of experience in Kalamunda and the Perth Hills." },
];

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Air conditioning service and repair",
  name: "Air Conditioning Service & Repairs Perth",
  areaServed: { "@type": "City", name: "Perth" },
  provider: { "@type": "HVACBusiness", name: business.name, url: business.url, telephone: "+61420496791" },
};

const promises = [
  {
    title: "Thorough fault-finding",
    body: "We track down the actual cause rather than guessing, and get your system working again as quickly as possible. We know being without it makes home or work uncomfortable and stressful.",
  },
  {
    title: "All brands, all models",
    body: "Split systems, ducted systems, multi-head units — we handle them all, including the older ones some companies won't touch.",
  },
  {
    title: "Up-front quotes",
    body: "Before any work starts you'll get a clear quote, so you know exactly what it will cost. No surprises when the bill arrives.",
  },
];

const faults = [
  { title: "Emergency breakdowns", body: "Unit dead or tripping breakers? We'll get it running fast.", image: imgBreakdown, alt: "Technician crouched beside an outdoor unit with gauges connected" },
  { title: "System diagnostics", body: "Full fault-finding to pinpoint inefficiencies and hidden errors.", image: imgDiagnostics, alt: "Technician testing an outdoor unit with a multimeter" },
  { title: "Airflow & temperature problems", body: "Weak air, uneven temps, or rooms not heating or cooling.", image: imgAirflow, alt: "Homeowner adjusting a wall-mounted air conditioning controller" },
  { title: "Water leaks", body: "Drips, pooling water or overflow alarms.", image: imgLeak, alt: "Water dripping from a wall-mounted split system" },
  { title: "Strange noises", body: "Buzzing, rattling, or squealing fans and compressors.", image: imgNoise, alt: "Technician inspecting underneath an outdoor unit" },
  { title: "Refrigerant gas leaks", body: "Lost cooling power, ice-ups or high energy bills.", image: imgGas, alt: "Technician connecting refrigerant gauges to an outdoor unit" },
];
---

<Layout
  title="Air Conditioning Service & Repairs Perth | Pro Vent"
  description="Air conditioning service and repairs in Perth for all brands — split, ducted and multi-head, including older systems. Up-front quotes. 0420 496 791."
  breadcrumbs={[{ name: "Service & Repairs", path: "/service-repairs" }]}
  jsonLd={[service, faqSchema(serviceFaqs)]}
>
  <PageHero
    eyebrow="Service & repairs"
    title="Air Conditioning Service & Repairs Perth"
    lead="Urgent breakdown or annual maintenance — we keep Perth homes and businesses running smoothly all year round."
    image={heroImg}
    imageAlt="Pro Vent technician checking refrigerant pressures on an outdoor unit"
    focus="25% center"
    callLabel="Urgent? Call now"
  />

  <FeatureSplit eyebrow="Air-con service & repairs" title="Here when your system isn't" items={promises} image={portraitImg} imageAlt="Pro Vent technician working on an air conditioning unit" callLabel="Urgent? Call now" />

  <section class="bg-muted py-16 sm:py-24">
    <div class="container-page">
      <SectionHeading eyebrow="What we fix" title="Common problems we solve every week" align="center" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {faults.map((f) => (
          <article class="group overflow-hidden rounded-2xl bg-card shadow-sm">
            <div class="aspect-[4/3] overflow-hidden">
              <Image src={f.image} alt={f.alt} widths={[400, 640]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </div>
            <div class="p-5">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-1 text-muted-foreground">{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <BenefitGrid eyebrow="Why choose Pro Vent" title="Local, experienced and easy to deal with" items={whyProVent} />
  <BrandStrip />

  <FaqSection title="Service & repair FAQs" faqs={serviceFaqs} muted />

  <section class="bg-ink py-16 text-white sm:py-20">
    <div class="container-page flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow !text-brand">Book your emergency repair</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">Air-con playing up? Give us a call.</h2>
        <p class="mt-3 text-lg text-ink-muted">Clear pricing, no hidden fees. Call and we'll get a licensed technician out to make your home comfortable again.</p>
      </div>
      <LinkButton href={business.phoneHref} size="xl" class="h-14 px-8 text-lg"><Phone class="size-5" />{business.phone}</LinkButton>
    </div>
  </section>
</Layout>
