---
import { Image } from "astro:assets";
import { Clock, Phone, ShieldCheck, Wrench } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import QuoteForm from "@/components/QuoteForm.tsx";
import { business } from "@/data/site";
import sideImg from "@/assets/images/tech-outdoor-unit.webp";

const points = [
  { icon: Clock, text: "Free measure-up and a fixed written quote" },
  { icon: Wrench, text: "Supply & install, service and repairs — all brands" },
  { icon: ShieldCheck, text: "3-year workmanship · 5-year product warranty" },
];
---

<Layout
  title="Request a Free Quote"
  description="Request a free air conditioning quote from Pro Vent. Ducted, split system and evaporative installs and repairs across Perth. Free measure-up."
  breadcrumbs={[{ name: "Request a Quote", path: "/request-a-quote" }]}
>
  <section class="bg-ink py-12 text-white sm:py-16">
    <div class="container-page max-w-3xl text-center">
      <p class="eyebrow !text-brand">Request a quote</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Instant price, zero fuss.</h1>
      <p class="mt-4 text-lg text-white/80">Send us your request and we'll come back with an in-depth quote.</p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_22rem] lg:gap-12">
      <QuoteForm client:load source="quote" phone={business.phone} phoneHref={business.phoneHref} />

      <aside class="flex flex-col gap-6">
        <div class="overflow-hidden rounded-2xl bg-ink text-white">
          <Image src={sideImg} alt="Pro Vent technician beside an outdoor unit" widths={[400, 700]} sizes="(min-width: 1024px) 22rem, 100vw" class="aspect-[4/3] w-full object-cover object-top" />
          <div class="p-6">
            <p class="text-sm text-ink-muted">Prefer to talk?</p>
            <a href={business.phoneHref} class="mt-1 flex items-center gap-2 text-2xl font-bold hover:text-brand">
              <Phone class="size-5 text-brand" />{business.phone}
            </a>
            <p class="mt-2 text-sm text-ink-muted">{business.area}</p>
          </div>
        </div>
        <ul class="space-y-4">
          {points.map(({ icon: Icon, text }) => (
            <li class="flex items-start gap-3">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent text-brand-dark"><Icon class="size-5" /></span>
              <span class="pt-1.5 text-sm font-medium">{text}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</Layout>
