---
import { CheckCircle2, ClipboardList, Phone } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import SystemComparison from "@/components/sections/SystemComparison.astro";
import QuoteBand from "@/components/sections/QuoteBand.astro";
import LinkButton from "@/components/LinkButton.astro";
import DuctedCostCalculator from "@/components/DuctedCostCalculator.tsx";
import { business } from "@/data/site";
import { ductedBands, ductedExtras, ductedFaqs, faqSchema, formatPrice, hasDuctedPricing, type Faq } from "@/data/ducted";

const pricedBands = ductedBands.filter((b) => b.from !== null);
const pricedExtras = ductedExtras.filter((e) => e.price !== null);

const factors = [
  { title: "Home size and layout", body: "The floor area, number of rooms and ceiling heights set the capacity (kW) you need. Open-plan living areas and high ceilings need more capacity than closed rooms with standard 2.4m ceilings." },
  { title: "Number of zones", body: "Each zone needs a motorised damper and controls. More zones add a little upfront but let you run only the rooms you use, which lowers running costs." },
  { title: "Roof space and access", body: "Low-pitched or tight roofs, double-storey homes and difficult access to the roof void all add labour. Tile and metal roofs also differ." },
  { title: "Brand and model", body: "Premium inverter units cost more upfront but are typically quieter and more efficient. We'll show you options across brands so you can compare." },
  { title: "Controller", body: "A standard wall controller is included with every system; smart Wi-Fi zone controllers with app control and room sensors cost extra." },
  { title: "Removing the old system", body: "Taking out an old evaporative cooler or ducted unit, and repairing the roof where it sat, is part of many Perth installs and should be in your quote." },
  { title: "Electrical work", body: "Larger systems may need a dedicated circuit or switchboard upgrade. A good quote will tell you upfront if that's needed." },
  { title: "Vents and finishes", body: "Standard round or square vents, or slim linear slot diffusers for a cleaner modern look." },
];

const compareChecklist = [
  "System capacity (kW) for heating and cooling, and the brand and model number",
  "Number of zones, and which rooms are in each",
  "Duct insulation rating and whether all ductwork is new",
  "Size and position of the return air grille",
  "Controller type — standard wall controller or smart zone control",
  "Removal of the old system and roof repair, if needed",
  "Any electrical work required",
  "Workmanship warranty and manufacturer's warranty",
];

const costFaqs: Faq[] = [
  ductedFaqs[0],
  {
    q: "What size ducted system do I need for a 4 bedroom house?",
    a: "It depends on more than bedroom count — floor area, ceiling height, insulation, window size and which way the house faces all matter. We do a proper load calculation when we measure up so the system isn't undersized (struggles on hot days) or oversized (costs more to buy and run).",
  },
  {
    q: "Is ducted air conditioning worth the cost?",
    a: "If you want even comfort through most of the house, heating as well as cooling, and nothing on your walls, ducted is usually worth it — especially with zoning so you only run the rooms in use. If you only need one to three rooms done, split systems are normally better value.",
  },
  {
    q: "Are there extra costs I should watch for?",
    a: "Ask whether the quote includes removing your old system, roof repairs, electrical work, the controller you want and all new ductwork. Our written quotes list everything so there are no surprises.",
  },
  ductedFaqs[1],
];
---

<Layout
  title="Ducted Air Conditioning Cost Perth | Price Guide"
  description="How much does ducted air conditioning cost in Perth? What affects the price, what should be in your quote, and how to compare installers. Free same-day ducted quotes from ProVent."
  breadcrumbs={[
    { name: "Ducted Air Conditioning", path: "/ducted-air-conditioning" },
    { name: "Cost Guide", path: "/ducted-air-conditioning-cost" },
  ]}
  jsonLd={[faqSchema(costFaqs)]}
>
  <section class="bg-ink py-14 text-white sm:py-20">
    <div class="container-page max-w-3xl">
      <p class="eyebrow !text-brand">Ducted cost guide · Perth</p>
      <h1 class="mt-3 text-4xl leading-[1.05] font-extrabold text-balance sm:text-5xl">How much does ducted air conditioning cost in Perth?</h1>
      <p class="mt-5 text-lg text-white/80">
        {hasDuctedPricing
          ? `Fully installed ducted reverse cycle systems start from ${formatPrice(Math.min(...pricedBands.map((b) => b.from!)))} (supply + install, inc GST). Use the calculator for a starting price for your home, then we'll confirm it with a free measure-up.`
          : "The honest answer is: it depends on your home. This guide explains what drives the price, what a good quote should include, and how to compare installers — then we'll give you an exact price after a free measure-up."}
      </p>
    </div>
  </section>

  {hasDuctedPricing ? (
    <section class="bg-muted py-12 sm:py-16">
      <div class="container-page">
        <SectionHeading eyebrow="Calculator" title="Ducted air conditioning cost calculator" class="mb-8" />
        <DuctedCostCalculator client:visible bands={pricedBands} extras={pricedExtras} phoneHref={business.phoneHref} />
      </div>
    </section>
  ) : (
    <section class="bg-muted py-12 sm:py-16">
      <div class="container-page">
        <div class="flex flex-col gap-6 rounded-2xl border bg-card p-6 shadow-sm sm:p-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex gap-4">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-accent text-brand-dark"><ClipboardList class="size-6" /></span>
            <div>
              <h2 class="text-xl font-bold">Want a price for your home today?</h2>
              <p class="mt-1 text-muted-foreground">Tell us your number of bedrooms, living areas and suburb. We'll send a same-day estimate and book a free measure-up.</p>
            </div>
          </div>
          <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
            <LinkButton href="/request-a-quote" size="xl">Get a same-day estimate</LinkButton>
            <LinkButton href={business.phoneHref} size="xl" variant="outline"><Phone class="size-4" />{business.phone}</LinkButton>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="py-16 sm:py-24">
    <div class="container-page">
      <SectionHeading
        eyebrow="What affects the price"
        title="What affects the cost of ducted air conditioning?"
        lead="Two homes with the same number of bedrooms can need very different systems. These are the things that move the price the most."
      />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {factors.map((f, i) => (
          <div class="rounded-2xl border bg-card p-6">
            <span class="font-display text-sm font-bold text-brand-dark">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-1 font-semibold">{f.title}</h3>
            <p class="mt-1.5 text-[0.95rem] leading-relaxed text-muted-foreground">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {pricedExtras.length > 0 && (
    <section class="bg-muted py-16 sm:py-20">
      <div class="container-page max-w-4xl">
        <SectionHeading eyebrow="Add-ons" title="Common extras" />
        <ul class="mt-8 divide-y rounded-2xl border bg-card">
          {pricedExtras.map((e) => (
            <li class="flex items-center justify-between gap-4 p-5">
              <div><p class="font-semibold">{e.label}</p><p class="text-sm text-muted-foreground">{e.detail}</p></div>
              <p class="shrink-0 font-display text-lg font-bold">+{formatPrice(e.price!)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="bg-ink py-16 text-white sm:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-16">
      <SectionHeading
        tone="dark"
        eyebrow="Comparing quotes"
        title="What should a ducted air conditioning quote include?"
        lead="The cheapest quote often leaves things out. Before you compare prices, make sure each quote covers the same things."
      />
      <ul class="space-y-3">
        {compareChecklist.map((item) => (
          <li class="flex gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
            <CheckCircle2 class="mt-0.5 size-5 shrink-0 text-brand" />
            <span class="text-white/90">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SystemComparison />

  <FaqSection title="Ducted cost FAQs" faqs={costFaqs} muted />

  <QuoteBand title="Get your exact ducted price" lead="Free measure-up, a fixed written quote, and no hidden extras. Most estimates go out the same day." />
</Layout>
