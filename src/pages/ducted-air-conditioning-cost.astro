---
import { CheckCircle2, Home } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import SystemComparison from "@/components/sections/SystemComparison.astro";
import QuoteBand from "@/components/sections/QuoteBand.astro";
import DuctedCostCalculator from "@/components/DuctedCostCalculator.tsx";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { business } from "@/data/site";
import {
  bandRange,
  doubleStoreyNote,
  ductedBands,
  ductedExtras,
  ductedFaqs,
  extraPrice,
  extrasList,
  faqSchema,
  installTimes,
  type Faq,
} from "@/data/ducted";

const factors = [
  { title: "Home size and layout", body: "Floor area, number of rooms and ceiling heights set the capacity (kW) you need. Open-plan living and high ceilings need more capacity than closed rooms with standard ceilings." },
  { title: "Number of zones", body: `Zones let you run only the rooms you're using. Additional zones are about ${extraPrice(ductedExtras.zone).replace(" per zone", "")} each.` },
  { title: "Single or double storey", body: "Double-storey homes may need ducts run between levels or separate systems upstairs and downstairs — we inspect first." },
  { title: "Roof space and access", body: "Tight or low-pitched roofs and difficult ceiling access add time. We specialise in the difficult jobs other installers avoid." },
  { title: "Brand and model", body: "Premium inverter units cost more upfront but are typically quieter and more efficient. We'll show you options across brands." },
  { title: "Controller", body: `A standard wall controller is included. An AirTouch 5 smart controller with app and zone control is ${extraPrice(ductedExtras.airTouch)} extra.` },
  { title: "Removing an evaporative cooler", body: `${extraPrice(ductedExtras.evapRemoval)} to remove it, including patching tiles. Metal roofs need the sheets patched: ${extraPrice(ductedExtras.roofSheets)}.` },
  { title: "Vents and finishes", body: `Standard vents are included. Slim linear vents are ${extraPrice(ductedExtras.linearVent)}, where no ceiling joists need cutting.` },
];

const compareChecklist = [
  "System capacity (kW) for heating and cooling, and the brand and model number",
  "Number of zones, and which rooms are in each",
  "All-new insulated ductwork (old evaporative ducts are too big to reuse)",
  "Size and position of the return air grille",
  "Controller type — standard wall controller or smart zone control like AirTouch 5",
  "Removal of the old system and how the roof will be patched",
  "Any electrical work required",
  "Workmanship warranty and manufacturer's warranty",
];

const [small, medium, large] = ductedBands;

const costFaqs: Faq[] = [
  ductedFaqs[0],
  ductedFaqs[1],
  {
    q: "Is ducted air conditioning worth the cost?",
    a: "If you want even comfort through most of the house, heating as well as cooling, and nothing on your walls, ducted is usually worth it — especially with zoning so you only run the rooms in use. If you only need one to three rooms done, split systems are normally better value.",
  },
  {
    q: "What extra costs should I watch for?",
    a: `Check whether the quote includes removing your old system and patching the roof, the number of zones you want, the controller, any electrical work and all-new ductwork. As a guide: evaporative removal ${extraPrice(ductedExtras.evapRemoval)}, metal roof sheet patching ${extraPrice(ductedExtras.roofSheets)}, AirTouch 5 ${extraPrice(ductedExtras.airTouch)}, extra zones about ${extraPrice(ductedExtras.zone)}, and linear vents ${extraPrice(ductedExtras.linearVent)}.`,
  },
  ductedFaqs[2],
  ductedFaqs[6],
];
---

<Layout
  title="Ducted Air Conditioning Cost Perth (2026 Prices) | Pro Vent"
  description={`Ducted air conditioning in Perth: ${bandRange(small)} (2–3 bed), ${bandRange(medium)} (4 bed), ${bandRange(large)} (5+ bed) installed. Calculator and add-on prices.`}
  breadcrumbs={[
    { name: "Ducted Air Conditioning", path: "/ducted-air-conditioning" },
    { name: "Cost Guide", path: "/ducted-air-conditioning-cost" },
  ]}
  jsonLd={[faqSchema(costFaqs)]}
>
  <section class="bg-ink py-14 text-white sm:py-20">
    <div class="container-page max-w-3xl">
      <p class="eyebrow !text-brand">Ducted cost guide · Perth</p>
      <h1 class="mt-3 text-4xl leading-[1.05] font-extrabold text-balance sm:text-5xl">How much does ducted air conditioning cost in Perth?</h1>
      <p class="mt-5 text-lg text-white/80">
        A fully installed ducted reverse cycle system typically costs <strong class="text-white">{bandRange(small)}</strong> for a 2–3 bedroom home,
        <strong class="text-white">{bandRange(medium)}</strong> for a 4 bedroom home, and <strong class="text-white">{bandRange(large)}</strong> for 5 bedrooms or more —
        supplied and installed, inc GST. Use the calculator for your home, then we'll confirm it with a free measure-up.
      </p>
    </div>
  </section>

  <section class="bg-muted py-12 sm:py-16">
    <div class="container-page">
      <SectionHeading eyebrow="Calculator" title="Ducted air conditioning cost calculator" class="mb-8" />
      <DuctedCostCalculator client:visible bands={ductedBands} extras={ductedExtras} doubleStoreyNote={doubleStoreyNote} phoneHref={business.phoneHref} />
    </div>
  </section>

  <section class="py-16 sm:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-[3fr_2fr] lg:gap-16">
      <div>
        <SectionHeading eyebrow="Price guide" title="Ducted air conditioning prices by home size" lead="Typical installed prices for single-storey Perth homes. Your exact price depends on the layout, roof space and extras." />
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card">
          <Table>
            <TableHeader>
              <TableRow className="bg-muted/60 hover:bg-muted/60">
                <TableHead className="py-4 pl-5 font-semibold">Home</TableHead>
                <TableHead className="py-4 font-semibold">System size</TableHead>
                <TableHead className="py-4 pr-5 font-semibold">Installed price</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {ductedBands.map((b) => (
                <TableRow>
                  <TableCell className="py-4 pl-5 font-medium whitespace-normal">{b.label}</TableCell>
                  <TableCell className="py-4">{b.kw ?? "—"}</TableCell>
                  <TableCell className="py-4 pr-5 font-semibold">{bandRange(b)}</TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
        <p class="mt-3 text-sm text-muted-foreground">Supply and install, inc GST. Install time is {installTimes.ducted}, or {installTimes.withEvapRemoval}.</p>
      </div>
      <div>
        <SectionHeading eyebrow="Extras" title="Common add-ons" />
        <ul class="mt-8 divide-y rounded-2xl border bg-card">
          {extrasList.map((e) => (
            <li class="flex items-start justify-between gap-4 p-5">
              <div><p class="font-semibold">{e.label}</p><p class="mt-0.5 text-sm text-muted-foreground">{e.detail}</p></div>
              <p class="shrink-0 text-right font-display font-bold">{extraPrice(e)}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-muted py-14 sm:py-16">
    <div class="container-page flex max-w-4xl gap-5">
      <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-accent text-brand-dark"><Home class="size-6" /></span>
      <div>
        <h2 class="text-2xl font-bold">What about double-storey homes?</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">{doubleStoreyNote}</p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24">
    <div class="container-page">
      <SectionHeading
        eyebrow="What affects the price"
        title="What affects the cost of ducted air conditioning?"
        lead="Two homes with the same number of bedrooms can need very different systems. These are the things that move the price the most."
      />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {factors.map((f, i) => (
          <div class="rounded-2xl border bg-card p-6">
            <span class="font-display text-sm font-bold text-brand-dark">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-1 font-semibold">{f.title}</h3>
            <p class="mt-1.5 text-[0.95rem] leading-relaxed text-muted-foreground">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink py-16 text-white sm:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-16">
      <SectionHeading
        tone="dark"
        eyebrow="Comparing quotes"
        title="What should a ducted air conditioning quote include?"
        lead="The cheapest quote often leaves things out. Before you compare prices, make sure each quote covers the same things."
      />
      <ul class="space-y-3">
        {compareChecklist.map((item) => (
          <li class="flex gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
            <CheckCircle2 class="mt-0.5 size-5 shrink-0 text-brand" />
            <span class="text-white/90">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SystemComparison />

  <FaqSection title="Ducted cost FAQs" faqs={costFaqs} muted />

  <QuoteBand title="Get your exact ducted price" lead="Free measure-up, a fixed written quote, and no hidden extras." />
</Layout>
