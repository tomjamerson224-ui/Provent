---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import QuoteBand from "@/components/sections/QuoteBand.astro";
import { Badge } from "@/components/ui/badge";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Air Conditioning Guides & Advice | Pro Vent"
  description="Straight-talking guides to ducted, split system and evaporative air conditioning in Perth — sizing, zoning, costs and which system suits your home."
  breadcrumbs={[{ name: "Blog", path: "/blog" }]}
>
  <section class="bg-ink py-12 text-white sm:py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow !text-brand">Guides & advice</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Air conditioning guides for Perth homes</h1>
      <p class="mt-4 text-lg text-white/80">Honest, practical advice from a local installer — how to choose, size and budget for the right system.</p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-page grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={`/blog/${p.id}`} class="group flex flex-col overflow-hidden rounded-2xl border bg-card transition hover:-translate-y-1 hover:shadow-lg">
          <div class="aspect-[16/9] overflow-hidden bg-muted">
            <Image src={p.data.heroImage} alt={p.data.heroAlt} widths={[400, 640]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <Badge variant="secondary" className="self-start">{p.data.category}</Badge>
            <h2 class="mt-3 text-lg leading-snug font-semibold group-hover:text-brand-dark">{p.data.title}</h2>
            <p class="mt-2 line-clamp-3 flex-1 text-sm text-muted-foreground">{p.data.description}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-dark">Read the guide <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <QuoteBand />
</Layout>
