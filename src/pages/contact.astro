---
import { Clock, Mail, MapPin, Phone } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import QuoteForm from "@/components/QuoteForm.tsx";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import { Card, CardContent } from "@/components/ui/card";
import { business } from "@/data/site";
import heroImg from "@/assets/images/team-van.avif";

const channels = [
  { icon: Phone, label: "Phone", value: business.phone, href: business.phoneHref },
  { icon: Mail, label: "Email", value: business.email, href: business.emailHref },
  { icon: Clock, label: "Hours", value: business.hours },
  { icon: MapPin, label: "Service area", value: "All of Perth, Western Australia" },
];
---

<Layout
  title="Contact Us"
  description="Contact ProVent Air Conditioning in Perth. Call 0420 496 791 or email info@proventairconditioning.com.au for quotes, service and 24/7 urgent repairs."
>
  <PageHero
    eyebrow="Contact us"
    title="We're one call away."
    lead="For a free quote or to ask anything at all, call or send us a message and one of our technicians will get back to you promptly."
    image={heroImg}
    imageAlt="ProVent technician walking to the branded van outside a Perth home"
    focus="65% center"
    showCtas={false}
  />

  <section class="py-12 sm:py-16">
    <div class="container-page grid gap-10 lg:grid-cols-[22rem_1fr] lg:gap-12">
      <div>
        <SectionHeading title="Get in touch today" />
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {channels.map(({ icon: Icon, label, value, href }) => (
            <Card size="sm" className="shadow-none">
              <CardContent className="flex items-center gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent text-brand-dark"><Icon class="size-5" /></span>
                <div class="min-w-0">
                  <p class="text-xs font-medium text-muted-foreground uppercase">{label}</p>
                  {href ? (
                    <a href={href} class="block font-semibold break-all hover:text-brand-dark">{value}</a>
                  ) : (
                    <p class="font-semibold">{value}</p>
                  )}
                </div>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
      <div>
        <SectionHeading title="Send us a message" lead="Fill in the form and we'll get back to you the same day." class="mb-6" />
        <QuoteForm client:visible source="contact" phone={business.phone} phoneHref={business.phoneHref} />
      </div>
    </div>
  </section>
</Layout>
