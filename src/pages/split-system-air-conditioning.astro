---
import SystemPage from "@/components/SystemPage.astro";
import heroImg from "@/assets/images/family-living-room.webp";
import whyImg from "@/assets/images/tech-van.webp";
---

<SystemPage
  path="/split-system-air-conditioning"
  category="split"
  seoTitle="Split System Air Conditioning Perth | Pro Vent"
  seoDescription="Split system air conditioning supplied and installed across Perth. Quiet, efficient heating and cooling for bedrooms and living areas. 3-year warranty."
  eyebrow="Split system air conditioning"
  title="Split System Air Conditioning Perth"
  lead="Targeted cooling and heating for the rooms you use most — quick to install, quiet to run and easy on the power bill."
  heroImage={heroImg}
  heroAlt="Family relaxing in a living room cooled by a wall-mounted split system"
  heroFocus="center 40%"
  whyTitle="Why choose a split system?"
  why={[
    { title: "Lower bills, better comfort", body: "Split systems are energy-efficient, keeping your space comfortable year-round while saving on energy bills." },
    { title: "Whisper-quiet airflow", body: "With the noisy components outside, the indoor unit runs quietly so you can enjoy your space without distraction." },
    { title: "Fits almost anywhere", body: "Ideal for bedrooms, living areas and offices — easy to install, simple to use, and they blend in with any décor." },
  ]}
  whyImage={whyImg}
  whyImageAlt="Pro Vent technician with tool bag beside the company van"
  benefitsTitle="Benefits of split system air conditioners"
  benefits={[
    { title: "Easy installation", body: "No ductwork needed — a quick, mess-free setup in almost any room." },
    { title: "Energy efficient", body: "Lower power use than whole-home systems for single rooms, helping trim electricity bills." },
    { title: "Fast cooling & heating", body: "Reaches your set temperature in minutes and holds it steady, quietly." },
    { title: "Better air quality", body: "Built-in filters and dehumidifying modes give you cleaner, healthier indoor air." },
  ]}
  projectsTitle="Split system installs"
/>
