---
import { Image } from "astro:assets";
import { Clock, ShieldCheck, Users, Wrench } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import FeatureSplit from "@/components/sections/FeatureSplit.astro";
import SystemPicker from "@/components/sections/SystemPicker.astro";
import ProjectGrid from "@/components/sections/ProjectGrid.astro";
import BrandStrip from "@/components/sections/BrandStrip.astro";
import Commitments from "@/components/sections/Commitments.astro";
import QuoteBand from "@/components/sections/QuoteBand.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import LinkButton from "@/components/LinkButton.astro";
import { ArrowRight } from "@lucide/astro";
import { projects } from "@/data/projects";
import { faqSchema, type Faq } from "@/data/ducted";

import heroImg from "@/assets/images/banner-van-customers.webp";
import daikinImg from "@/assets/images/daikin-outdoor-unit.avif";
import roofImg from "@/assets/images/ducting-roof-space.webp";

const ductedLinks = [
  { title: "Ducted air conditioning", body: "Whole-home reverse cycle, designed and zoned for your floor plan.", href: "/ducted-air-conditioning" },
  { title: "Evaporative to ducted", body: "Swap the old roof cooler for ducted reverse cycle — roof repair included.", href: "/evaporative-to-ducted-reverse-cycle" },
  { title: "Ducted cost guide", body: "What drives the price in Perth and what a good quote should include.", href: "/ducted-air-conditioning-cost" },
];

const homeFaqs: Faq[] = [
  { q: "What areas of Perth do you service?", a: "We cover the Perth CBD and surrounding suburbs, and we have a lot of experience in Kalamunda and the Perth Hills. Send a quote request with your suburb and we'll confirm availability." },
  { q: "Do you specialise in ducted air conditioning?", a: "Yes — ducted reverse cycle is our specialty, including new installs, replacements and converting old evaporative systems to ducted. We also supply and install split systems and evaporative air conditioning." },
  { q: "How much does ducted air conditioning cost?", a: "As a guide, $7,000–$12,000 for a 2–3 bedroom home, $10,000–$15,000 for 4 bedrooms and $16,000+ for 5 bedrooms or more, supplied and installed. Double-storey homes need an inspection first. Our ducted cost guide has the full breakdown and a calculator." },
  { q: "What warranty do you offer?", a: "Every installation comes with a 3-year warranty on our workmanship and a 5-year manufacturer's warranty on the air conditioning units we supply." },
  { q: "Do you repair air conditioners you didn't install?", a: "Yes. We service and repair all brands and models — split, ducted and multi-head — including older systems other companies won't touch." },
];

const trust = [
  { icon: Users, label: "Family-owned, Perth-based" },
  { icon: Wrench, label: "10+ years experience" },
  { icon: ShieldCheck, label: "3-yr work · 5-yr product warranty" },
  { icon: Clock, label: "Ducted installs in half a day" },
];

const approach = [
  { title: "Plan & Assess", body: "We look at your space, how you live and your budget before recommending anything." },
  { title: "Tailored Design", body: "Ducted, split or something else — a system sized and designed for your home." },
  { title: "Precise Install", body: "Neat, sealed, tested and tidy, with pipes run out of sight." },
];

const challenging = [
  {
    title: "We handle tricky installs",
    body: "Tight roof spaces, heritage walls, odd layouts — if other companies say “no way”, we'll find a way, using specialised tools and creative solutions without compromising finish or warranty.",
  },
  {
    title: "We fix complex faults",
    body: "Detailed troubleshooting and part-level repairs can bring “broken” units back to life, saving costly replacements and minimising downtime for homes and businesses alike.",
  },
  {
    title: "We deliver major retrofits",
    body: "Complete system upgrades or redesigns that bring modern efficiency to older homes and businesses — long-term savings, better comfort and compliance with current standards.",
  },
];
---

<Layout
  title="Air Conditioning Perth | Ducted Specialists | Pro Vent"
  jsonLd={[faqSchema(homeFaqs)]}
  description="Family-owned Perth air conditioning installers specialising in ducted reverse cycle from $7,000. Evap-to-ducted conversions, split systems and repairs."
>
  <PageHero
    eyebrow="Stay cool Perth. We make aircon simple."
    title="Air Conditioning Perth — Ducted Specialists"
    lead="Family-owned Perth installers of ducted reverse cycle, split system and evaporative air conditioning — with straightforward advice and hassle-free installs."
    image={heroImg}
    imageAlt="Pro Vent technician talking with homeowners beside the Pro Vent van"
    focus="70% center"
    callLabel="Call us now"
  >
    <ul class="mt-8 grid max-w-xl grid-cols-2 gap-x-6 gap-y-3 text-sm text-white/85">
      {trust.map(({ icon: Icon, label }) => (
        <li class="flex items-center gap-2"><Icon class="size-4 shrink-0 text-brand" />{label}</li>
      ))}
    </ul>
  </PageHero>

  <section class="py-16 sm:py-24">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading
          eyebrow="Perth's go-to aircon team"
          title="Looking for the right air-con setup?"
          lead="At Pro Vent we keep things simple and local. Our Perth-based team gives honest advice to help you pick the right heating or cooling system without the stress."
        />
        <p class="mt-4 text-muted-foreground">
          We'll help you choose a system — ducted, split or something else — that fits your space, lifestyle and budget.
        </p>
        <ol class="mt-8 grid gap-4 sm:grid-cols-3">
          {approach.map((step, i) => (
            <li class="rounded-xl border bg-card p-4">
              <span class="font-display text-sm font-bold text-brand-dark">0{i + 1}</span>
              <h3 class="mt-1 font-semibold">{step.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <Image
        src={daikinImg}
        alt="Daikin outdoor air conditioning unit installed against a Perth home"
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-xl"
      />
    </div>
  </section>

  <section class="bg-ink py-16 text-white sm:py-20">
    <div class="container-page">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          tone="dark"
          eyebrow="Our specialty"
          title="Perth's ducted air conditioning specialists"
          lead="Most of what we do is ducted reverse cycle — new installs, replacements and swapping out old evaporative coolers. Designed properly, zoned properly, installed tidily."
        />
        <LinkButton href="/ducted-air-conditioning" size="xl" class="self-start lg:self-auto">Explore ducted <ArrowRight class="size-4" /></LinkButton>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {ductedLinks.map((l) => (
          <a href={l.href} class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition hover:border-brand hover:bg-white/10">
            <h3 class="text-lg font-semibold text-white">{l.title}</h3>
            <p class="mt-2 text-ink-muted">{l.body}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand">Learn more <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FeatureSplit
    muted
    eyebrow="No job too hard"
    title="We take on the challenging jobs others avoid"
    items={challenging}
    image={roofImg}
    imageAlt="Ducting being installed through an open roof frame"
    reverse
  />

  <SystemPicker />

  <ProjectGrid
    title="Our latest installations"
    lead="A few recent jobs from around Perth — homes and local businesses alike."
    projects={projects}
  />

  <BrandStrip />

  <Commitments />

  <FaqSection faqs={homeFaqs} muted />

  <QuoteBand />
</Layout>
