---
import { ArrowRight, MapPin } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/sections/SectionHeading.astro";
import QuoteBand from "@/components/sections/QuoteBand.astro";
import { areas } from "@/data/areas";
import { business } from "@/data/site";
---

<Layout
  title="Service Areas | Pro Vent Air Conditioning WA"
  description="Air conditioning across the Perth CBD and surrounds, Kalamunda and the Perth Hills, Mundaring, Roleystone, Armadale, Byford and down to Serpentine–Jarrahdale."
  breadcrumbs={[{ name: "Service areas", path: "/areas" }]}
>
  <section class="bg-ink py-12 text-white sm:py-16">
    <div class="container-page max-w-3xl">
      <p class="eyebrow !text-brand">Service areas</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Where we install air conditioning</h1>
      <p class="mt-4 text-lg text-white/80">We cover the Perth CBD and surrounding suburbs, and we do a lot of work up in the Hills and down through the south-east corridor.</p>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Local areas" title="Hills and south-east areas" />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {areas.map((a) => (
          <a href={a.href} class="group flex flex-col rounded-2xl border bg-card p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-lg sm:p-8">
            <span class="flex size-11 items-center justify-center rounded-xl bg-accent text-brand-dark"><MapPin class="size-5" /></span>
            <h2 class="mt-4 text-xl font-bold">{a.title}</h2>
            <p class="mt-2 text-muted-foreground">{a.intro}</p>
            <p class="mt-3 flex-1 text-sm text-muted-foreground"><span class="font-medium text-foreground">Suburbs:</span> {a.blurb}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 font-semibold text-brand-dark">View area <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" /></span>
          </a>
        ))}
      </div>
      <div class="mt-8 rounded-2xl bg-muted p-6 sm:p-8">
        <h2 class="text-xl font-bold">Perth CBD & surrounding suburbs</h2>
        <p class="mt-2 text-muted-foreground">We also work right across the Perth CBD and the suburbs around it. Not sure if we cover you? <a href="/request-a-quote" class="font-medium text-foreground underline decoration-brand decoration-2 underline-offset-4">Send us your suburb</a> or call <a href={business.phoneHref} class="font-medium text-foreground underline decoration-brand decoration-2 underline-offset-4">{business.phone}</a>.</p>
      </div>
    </div>
  </section>

  <QuoteBand />
</Layout>
