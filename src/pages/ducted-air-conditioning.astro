---
import SystemPage from "@/components/SystemPage.astro";
import heroImg from "@/assets/images/ducted-living-room.webp";
import whyImg from "@/assets/images/tech-outdoor-unit.webp";
---

<SystemPage
  path="/ducted-air-conditioning"
  category="ducted"
  seoTitle="Ducted Air Conditioning Perth — Supply & Install"
  seoDescription="Ducted reverse cycle air conditioning installed across Perth. Whole-home comfort, smart zoning, hidden ducts and slim vents. Daikin, Panasonic, Fujitsu, ActronAir & more."
  eyebrow="Ducted air conditioning"
  title="Whole-home climate control."
  lead="One powerful central system, hidden ducting and slim ceiling vents — keeping every room comfortable through Perth's hot summers and chilly winters."
  heroImage={heroImg}
  heroAlt="Bright open-plan living room with slim ceiling vents from a ducted system"
  whyTitle="Why choose ducted air conditioning?"
  why={[
    { title: "Complete climate control", body: "A powerful central unit keeps every room evenly heated and cooled — ideal for Perth's hot summers and chilly winters." },
    { title: "Quiet operation", body: "The noisy part sits outside, so inside you'll hear little more than a gentle breeze from the slim ceiling vents." },
    { title: "Hidden design", body: "All the ductwork is tucked away in the roof, giving your rooms clean lines and more free wall space." },
    { title: "Energy-smart zoning", body: "Cool or heat only the rooms you're using to keep energy bills down." },
  ]}
  whyImage={whyImg}
  whyImageAlt="ProVent technician beside a ducted outdoor unit"
  benefitsTitle="Benefits of ducted air conditioners"
  benefits={[
    { title: "Whole-home comfort", body: "One central unit controls the temperature in every room, just the way you like it, all year long." },
    { title: "Smart zoning", body: "Heat or cool only the rooms you're using, saving energy and money." },
    { title: "Clean, modern look", body: "Hidden ducts and slim vents blend in with your home's style without cluttering your space." },
    { title: "Whisper-quiet operation", body: "The loud parts are outside, so indoor spaces stay quiet and peaceful." },
  ]}
  projectsTitle="Ducted air conditioner installs"
/>
