---
import Layout from "@/layouts/Layout.astro";
import CtaButtons from "@/components/sections/CtaButtons.astro";
import { systems, services } from "@/data/site";
---

<Layout title="Page not found" description="The page you're looking for couldn't be found." noindex>
  <section class="bg-ink py-20 text-white sm:py-28">
    <div class="container-page max-w-2xl text-center">
      <p class="font-display text-7xl font-extrabold text-brand">404</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">This page has gone cold.</h1>
      <p class="mt-4 text-lg text-white/75">The page you're after has moved or no longer exists. Try one of these instead, or give us a call.</p>
      <CtaButtons class="mt-8 justify-center" />
      <ul class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
        {[...services, ...systems].map((l) => <li><a href={l.href} class="text-white/80 underline-offset-4 hover:text-brand hover:underline">{l.title}</a></li>)}
      </ul>
    </div>
  </section>
</Layout>
