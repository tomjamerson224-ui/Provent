---
import { getImage } from "astro:assets";
import { MapPin, Mail, Phone, ShieldCheck } from "@lucide/astro";
import SiteNav, { type MenuEntry } from "./SiteNav.tsx";
import { business, mainNav, type NavLink } from "@/data/site";
import { cleanPath } from "@/lib/utils";
import logoBadge from "@/assets/images/logo-badge.png";
import logoWordmark from "@/assets/images/logo-wordmark.avif";

// Menu imagery is optimised here so the React island only gets small URLs.
async function resolve(items: NavLink[]): Promise<MenuEntry[]> {
  return Promise.all(
    items.map(async ({ icon, image, ...rest }) => ({
      ...rest,
      icon: icon ? (await getImage({ src: icon, width: 112, format: "webp" })).src : undefined,
      image: image ? (await getImage({ src: image, width: 520, format: "webp" })).src : undefined,
    })),
  );
}

const [services, systems, badge, wordmark] = await Promise.all([
  resolve(mainNav.services),
  resolve(mainNav.systems),
  getImage({ src: logoBadge, width: 96, format: "webp" }),
  getImage({ src: logoWordmark, width: 360, format: "webp" }),
]);
---

<header class="sticky top-0 z-40 bg-ink text-ink-foreground shadow-[0_1px_0_rgb(255_255_255/0.06)]">
  <div class="hidden border-b border-white/10 text-[0.8rem] text-ink-muted md:block">
    <div class="container-page flex h-9 items-center justify-between">
      <div class="flex items-center gap-5">
        <span class="flex items-center gap-1.5"><MapPin class="size-3.5 text-brand" />{business.area}</span>
        <span class="flex items-center gap-1.5"><ShieldCheck class="size-3.5 text-brand" />3-yr workmanship · 5-yr product warranty</span>
      </div>
      <div class="flex items-center gap-5">
        <a href={business.emailHref} class="flex items-center gap-1.5 hover:text-white"><Mail class="size-3.5" />{business.email}</a>
        <a href={business.phoneHref} class="flex items-center gap-1.5 font-medium text-white hover:text-brand"><Phone class="size-3.5" />{business.phone}</a>
      </div>
    </div>
  </div>
  <SiteNav
    client:load
    currentPath={cleanPath(Astro.url.pathname)}
    logoBadge={badge.src}
    logoWordmark={wordmark.src}
    services={services}
    systems={systems}
    links={mainNav.links}
    phone={business.phone}
    phoneHref={business.phoneHref}
    email={business.email}
    emailHref={business.emailHref}
  />
</header>
