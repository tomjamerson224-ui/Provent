---
import { Image } from "astro:assets";
import { Phone } from "@lucide/astro";
import LinkButton from "@/components/LinkButton.astro";
import { business } from "@/data/site";
import logoBadge from "@/assets/images/logo-badge.png";
import logoWordmark from "@/assets/images/logo-wordmark.avif";

// Paid-traffic header: no navigation, just the two conversion actions.
---

<header class="sticky top-0 z-40 bg-ink text-white shadow-[0_1px_0_rgb(255_255_255/0.06)]">
  <div class="container-page flex h-16 items-center justify-between gap-3 sm:h-18">
    <span class="flex shrink-0 items-center gap-2.5">
      <Image src={logoBadge} alt="" width={44} height={44} class="size-9 rounded-full ring-1 ring-white/20 sm:size-11" />
      <Image src={logoWordmark} alt="Pro Vent Air Conditioning WA" width={170} class="h-8 w-auto sm:h-10" />
    </span>
    <div class="flex items-center gap-2">
      <LinkButton href={business.phoneHref} variant="ghost" size="lg" class="h-10 px-3 text-white hover:bg-white/10 hover:text-white">
        <Phone class="size-4 text-brand" /><span class="hidden sm:inline">{business.phone}</span><span class="sm:hidden">Call</span>
      </LinkButton>
      <LinkButton href="#quote" size="lg" class="hidden h-10 px-4 font-semibold sm:inline-flex">Free quote</LinkButton>
    </div>
  </div>
</header>
