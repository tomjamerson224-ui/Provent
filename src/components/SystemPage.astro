---
import type { ImageMetadata } from "astro";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import FeatureSplit from "@/components/sections/FeatureSplit.astro";
import BenefitGrid from "@/components/sections/BenefitGrid.astro";
import HowWeWork from "@/components/sections/HowWeWork.astro";
import ProjectGrid from "@/components/sections/ProjectGrid.astro";
import BrandStrip from "@/components/sections/BrandStrip.astro";
import Commitments from "@/components/sections/Commitments.astro";
import SystemPicker from "@/components/sections/SystemPicker.astro";
import QuoteBand from "@/components/sections/QuoteBand.astro";
import { whyProVent } from "@/data/site";
import { projectsFor, type SystemCategory } from "@/data/projects";

type Item = { title: string; body: string };

interface Props {
  path: string;
  category: SystemCategory;
  seoTitle: string;
  seoDescription: string;
  eyebrow: string;
  title: string;
  lead: string;
  heroImage: ImageMetadata;
  heroAlt: string;
  heroFocus?: string;
  whyTitle: string;
  why: Item[];
  whyImage: ImageMetadata;
  whyImageAlt: string;
  benefitsTitle: string;
  benefits: Item[];
  projectsTitle: string;
}
const p = Astro.props;
---

<Layout title={p.seoTitle} description={p.seoDescription} breadcrumbs={[{ name: p.eyebrow.replace(/^./, (c) => c.toUpperCase()), path: p.path }]}>
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} image={p.heroImage} imageAlt={p.heroAlt} focus={p.heroFocus} />
  <FeatureSplit eyebrow={p.eyebrow} title={p.whyTitle} items={p.why} image={p.whyImage} imageAlt={p.whyImageAlt} />
  <BenefitGrid eyebrow="Benefits" title={p.benefitsTitle} items={p.benefits} />
  <FeatureSplit reverse eyebrow="Why choose ProVent" title="Local, experienced and easy to deal with" items={whyProVent} image={p.heroImage} imageAlt={p.heroAlt} />
  <HowWeWork />
  <ProjectGrid title={p.projectsTitle} projects={projectsFor(p.category)} />
  <BrandStrip />
  <Commitments />
  <SystemPicker current={p.path} />
  <QuoteBand />
</Layout>
