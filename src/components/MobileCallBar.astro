---
import { Phone, FileText } from "@lucide/astro";
import { business } from "@/data/site";
---

<!-- Thumb-reach call/quote bar on phones; the footer pads for it. -->
<div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2 border-t border-white/10 bg-ink/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur md:hidden">
  <a href={business.phoneHref} class="flex h-11 items-center justify-center gap-2 rounded-lg border border-white/15 text-sm font-semibold text-white">
    <Phone class="size-4 text-brand" /> Call now
  </a>
  <a href="/request-a-quote" class="flex h-11 items-center justify-center gap-2 rounded-lg bg-brand text-sm font-semibold text-ink">
    <FileText class="size-4" /> Free quote
  </a>
</div>
