---
import { Check, Minus, X } from "@lucide/astro";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import SectionHeading from "./SectionHeading.astro";

type Mark = "yes" | "partial" | "no";
const rows: { label: string; ducted: [Mark, string]; split: [Mark, string]; evap: [Mark, string] }[] = [
  { label: "Heats in winter", ducted: ["yes", "Yes"], split: ["yes", "Yes"], evap: ["no", "No"] },
  { label: "Whole-home comfort", ducted: ["yes", "Every zoned room"], split: ["partial", "Room by room"], evap: ["yes", "Most rooms"] },
  { label: "Works with windows closed", ducted: ["yes", "Yes"], split: ["yes", "Yes"], evap: ["no", "Needs open windows"] },
  { label: "Effective on humid days", ducted: ["yes", "Yes"], split: ["yes", "Yes"], evap: ["partial", "Less effective"] },
  { label: "What you see inside", ducted: ["yes", "Slim ceiling vents"], split: ["partial", "A unit on each wall"], evap: ["yes", "Ceiling vents"] },
  { label: "Cool only the rooms in use", ducted: ["yes", "With zoning"], split: ["yes", "Yes"], evap: ["partial", "Limited"] },
  { label: "Upfront cost", ducted: ["partial", "Highest"], split: ["yes", "Lowest for 1–3 rooms"], evap: ["yes", "Lower"] },
];
const icon = { yes: Check, partial: Minus, no: X };
const tone = { yes: "text-green-600", partial: "text-brand-dark", no: "text-destructive" };
---

<section class="py-16 sm:py-24">
  <div class="container-page">
    <SectionHeading
      eyebrow="Compare your options"
      title="Ducted vs split system vs evaporative"
      lead="Every home is different. Here's how the three main types of air conditioning compare for a typical Perth house."
      align="center"
    />
    <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
      <Table className="min-w-[640px]">
        <TableHeader>
          <TableRow className="bg-muted/60 hover:bg-muted/60">
            <TableHead className="w-[28%] py-4 pl-5 font-semibold">&nbsp;</TableHead>
            <TableHead className="py-4 font-semibold text-foreground"><a href="/ducted-air-conditioning" class="hover:text-brand-dark">Ducted reverse cycle</a></TableHead>
            <TableHead className="py-4 font-semibold text-foreground"><a href="/split-system-air-conditioning" class="hover:text-brand-dark">Split system</a></TableHead>
            <TableHead className="py-4 font-semibold text-foreground"><a href="/evaporative-air-conditioning" class="hover:text-brand-dark">Evaporative</a></TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {rows.map((r) => (
            <TableRow>
              <TableHead scope="row" className="h-auto py-4 pl-5 font-medium text-foreground">{r.label}</TableHead>
              {[r.ducted, r.split, r.evap].map(([mark, text]) => {
                const Icon = icon[mark];
                return (
                  <TableCell className="py-4">
                    <span class="flex items-center gap-2 whitespace-normal">
                      <Icon class:list={["size-4 shrink-0", tone[mark]]} stroke-width={3} />
                      {text}
                    </span>
                  </TableCell>
                );
              })}
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  </div>
</section>
