---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Check } from "@lucide/astro";
import SectionHeading from "./SectionHeading.astro";
import CtaButtons from "./CtaButtons.astro";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  items: { title: string; body: string }[];
  image: ImageMetadata;
  imageAlt: string;
  reverse?: boolean;
  muted?: boolean;
  callLabel?: string;
}
const { eyebrow, title, lead, items, image, imageAlt, reverse = false, muted = false, callLabel } = Astro.props;
---

<section class:list={["overflow-hidden py-16 sm:py-24", muted && "bg-muted"]}>
  <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class:list={[reverse && "lg:order-2"]}>
      <SectionHeading eyebrow={eyebrow} title={title} lead={lead} />
      <ul class="mt-8 space-y-6">
        {items.map((item) => (
          <li class="flex gap-4">
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-brand text-ink">
              <Check class="size-4" stroke-width={3} />
            </span>
            <div>
              <h3 class="text-lg font-semibold">{item.title}</h3>
              <p class="mt-1 leading-relaxed text-muted-foreground">{item.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <CtaButtons class="mt-9" tone="light" callLabel={callLabel} />
    </div>
    <div class:list={["relative mx-3 sm:mx-4", reverse && "lg:order-1"]}>
      <div class="absolute -inset-3 -z-10 rotate-2 rounded-3xl bg-brand/25 sm:-inset-4"></div>
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-[4/5] w-full rounded-2xl object-cover shadow-xl sm:aspect-[4/3] lg:aspect-[4/5]"
      />
    </div>
  </div>
</section>
