---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  title?: string;
  /** Only show posts in these categories (all when omitted). */
  categories?: string[];
  limit?: number;
}
const { title = "Guides & advice", categories, limit = 3 } = Astro.props;
const posts = (await getCollection("blog", ({ data }) => !data.draft && (!categories || categories.includes(data.category))))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
---

{posts.length > 0 && (
  <section class="py-16 sm:py-24">
    <div class="container-page">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading eyebrow="From the blog" title={title} lead="Straight answers from a local installer on choosing, sizing and budgeting for air conditioning." />
        <LinkButton href="/blog" variant="outline" size="lg" class="self-start bg-white sm:self-auto">All guides <ArrowRight class="size-4" /></LinkButton>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <a href={`/blog/${p.id}`} class="group flex flex-col overflow-hidden rounded-2xl border bg-card transition hover:-translate-y-1 hover:shadow-lg">
            <div class="aspect-[16/9] overflow-hidden bg-muted">
              <Image src={p.data.heroImage} alt={p.data.heroAlt} widths={[400, 640]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-lg leading-snug font-semibold group-hover:text-brand-dark">{p.data.title}</h3>
              <p class="mt-2 line-clamp-2 flex-1 text-sm text-muted-foreground">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
