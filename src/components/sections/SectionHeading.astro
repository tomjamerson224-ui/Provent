---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  tone?: "light" | "dark";
  class?: string;
}
const { eyebrow, title, lead, align = "left", tone = "light", class: className } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center", className]}>
  {eyebrow && <p class:list={["eyebrow", tone === "dark" && "!text-brand"]}>{eyebrow}</p>}
  <h2 class:list={["mt-2 text-3xl font-bold text-balance sm:text-4xl", tone === "dark" && "text-white"]}>{title}</h2>
  {lead && <p class:list={["mt-4 text-lg", tone === "dark" ? "text-ink-muted" : "text-muted-foreground"]}>{lead}</p>}
</div>
