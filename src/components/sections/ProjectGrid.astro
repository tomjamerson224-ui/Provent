---
import { ArrowRight } from "@lucide/astro";
import LinkButton from "@/components/LinkButton.astro";
import type { Project } from "@/data/projects";
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  title: string;
  lead?: string;
  projects: Project[];
  limit?: number;
  muted?: boolean;
}
const { title, lead, projects, limit = 6, muted = true } = Astro.props;
const shown = projects.slice(0, limit);
---

{shown.length > 0 && (
  <section class:list={["py-16 sm:py-24", muted && "bg-muted"]}>
    <div class="container-page">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading eyebrow="Our work" title={title} lead={lead} />
        <LinkButton href="/projects" variant="outline" size="lg" class="self-start bg-white sm:self-auto">View all projects <ArrowRight class="size-4" /></LinkButton>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {shown.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
)}
