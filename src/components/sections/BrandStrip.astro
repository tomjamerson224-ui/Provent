---
import { Image } from "astro:assets";
import daikin from "@/assets/brands/daikin.avif";
import panasonic from "@/assets/brands/panasonic.avif";
import fujitsu from "@/assets/brands/fujitsu.avif";
import actron from "@/assets/brands/actronair.avif";
import mitsubishi from "@/assets/brands/mitsubishi.avif";
import toshiba from "@/assets/brands/toshiba.avif";

const brands = [
  { src: daikin, name: "Daikin" },
  { src: panasonic, name: "Panasonic" },
  { src: fujitsu, name: "Fujitsu" },
  { src: actron, name: "ActronAir" },
  { src: mitsubishi, name: "Mitsubishi Electric" },
  { src: toshiba, name: "Toshiba" },
];
---

<section class="border-y bg-white py-12">
  <div class="container-page">
    <p class="text-center text-sm font-medium text-muted-foreground">We install Australia's most trusted air-con brands</p>
    <ul class="mt-6 grid grid-cols-3 items-center gap-6 sm:grid-cols-6">
      {brands.map((b) => (
        <li class="flex justify-center">
          <Image src={b.src} alt={b.name} height={48} class="h-10 w-auto object-contain opacity-80 grayscale transition hover:opacity-100 hover:grayscale-0 sm:h-12" />
        </li>
      ))}
    </ul>
  </div>
</section>
