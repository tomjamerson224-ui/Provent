---
// Self-hosted fonts (latin only) — the Google Fonts stylesheet was
// render-blocking for ~1s on mobile.
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/montserrat/latin-600.css";
import "@fontsource/montserrat/latin-700.css";
import "@fontsource/montserrat/latin-800.css";
import "@/styles/global.css";
import poppins400 from "@fontsource/poppins/files/poppins-latin-400-normal.woff2?url";
import poppins600 from "@fontsource/poppins/files/poppins-latin-600-normal.woff2?url";
import montserrat700 from "@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url";
import montserrat800 from "@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import MobileCallBar from "@/components/MobileCallBar.astro";
import LandingHeader from "@/components/LandingHeader.astro";
import { business, tracking } from "@/data/site";
import { cleanPath } from "@/lib/utils";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image for social cards. */
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (FAQPage, Service, etc.). */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail after Home, e.g. [{ name: "Ducted", path: "/ducted-air-conditioning" }]. */
  breadcrumbs?: { name: string; path: string }[];
  /** Paid-traffic landing page: no site nav, minimal footer, quote bar jumps to #quote. */
  landing?: boolean;
}

const { title, description, ogImage = "/og-default.png", noindex = false, jsonLd = [], breadcrumbs = [], landing = false } = Astro.props;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site);
const fullTitle = title.includes(business.shortName) ? title : `${title} | ${business.name}`;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  name: business.name,
  url: business.url,
  telephone: "+61420496791",
  email: business.email,
  image: new URL("/icon-512.png", Astro.site).toString(),
  logo: new URL("/icon-512.png", Astro.site).toString(),
  alternateName: "ProVent Air Conditioning",
  areaServed: [
    { "@type": "City", name: "Perth" },
    { "@type": "City", name: "Kalamunda" },
  ],
  address: { "@type": "PostalAddress", addressLocality: "Perth", addressRegion: "WA", addressCountry: "AU" },
  priceRange: "$$",
};

const breadcrumbList = breadcrumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Home", path: "/" }, ...breadcrumbs].map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: new URL(c.path, Astro.site).toString(),
      })),
    }
  : null;
const schemas = [localBusiness, ...(breadcrumbList ? [breadcrumbList] : []), ...jsonLd];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#191c1e" />

    {/* Preload the fonts used above the fold so the headline doesn't reflow (CLS). */}
    {[poppins400, poppins600, montserrat700, montserrat800].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />


    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

    {tracking.googleAdsId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${tracking.googleAdsId}`}></script>}
    <script is:inline define:vars={{ t: tracking }}>
      // Conversion hooks: tel: taps and quote-form submissions (QuoteForm
      // dispatches "pv:lead"). Always pushed to dataLayer; sent to Google Ads
      // when IDs are set in src/data/site.ts.
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      if (t.googleAdsId) { gtag("js", new Date()); gtag("config", t.googleAdsId); }
      document.addEventListener("click", function (e) {
        var a = e.target.closest && e.target.closest('a[href^="tel:"]');
        if (!a) return;
        dataLayer.push({ event: "phone_click", page: location.pathname });
        if (t.googleAdsId && t.callLabel) gtag("event", "conversion", { send_to: t.googleAdsId + "/" + t.callLabel });
      });
      window.addEventListener("pv:lead", function (e) {
        dataLayer.push({ event: "lead_submit", form: e.detail && e.detail.source, page: location.pathname });
        if (t.googleAdsId && t.leadLabel) gtag("event", "conversion", { send_to: t.googleAdsId + "/" + t.leadLabel });
      });
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-brand focus:px-3 focus:py-2 focus:text-ink">Skip to content</a>
    {landing ? <LandingHeader /> : <SiteHeader />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {landing ? (
      <footer class="bg-ink pb-24 text-sm text-ink-muted md:pb-0">
        <div class="container-page flex flex-col gap-2 py-6 sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} {business.name} · ARCtick {business.arctick}</p>
          <p><a href="/" class="hover:text-white">proventairconditioning.com.au</a> · <a href="/privacy" class="hover:text-white">Privacy</a></p>
        </div>
      </footer>
    ) : <SiteFooter />}
    <MobileCallBar quoteHref={landing ? "#quote" : undefined} />
    <script>
      // Lead source tracking — see src/lib/attribution.ts.
      import { recordVisit } from "@/lib/attribution";
      recordVisit();
    </script>
  </body>
</html>
